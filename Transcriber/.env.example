# API
NODE_ENV=development
PORT=3000
API_KEY=
CORS_ORIGIN=*
MAX_UPLOAD_BYTES=5368709120
TEMP_FILE_TTL_HOURS=24
JOB_RETENTION_HOURS=168
JOB_CONCURRENCY=1
WHISPER_BASE_URL=http://whisper:8000
