{
  "name": "insight-core",
  "version": "0.0.1",
  "private": true,
  "description": "Backend API and orchestrator for Insight",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --verbose",
    "migrate:up": "sequelize-cli db:migrate",
    "migrate:make": "sequelize-cli migration:generate --name",
    "migrate:down": "sequelize-cli db:migrate:undo",
    "migrate:down:all": "sequelize-cli db:migrate:undo:all"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-list-endpoints": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=10.0.0 <11.0.0"
  }
}
